#version 460 core

// RCAS — Robust Contrast Adaptive Sharpening, the second half of FSR1.
//
// Own implementation from the published algorithm. A 3x3 cross is sharpened by
// a single negative-lobe kernel whose strength is chosen per pixel so that the
// result cannot leave the [0,1] range: the limiter looks at how close the
// neighbourhood already is to black and to white and shrinks the lobe until no
// clipping is possible. That is what makes it "robust" — no halo, no clipped
// highlights, unlike a fixed unsharp mask.
//
// Runs after EASU and in the same display-referred space.

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D uInput;
layout(rgba16f, binding = 0) uniform writeonly image2D uOutput;

// 0 = sharpest, larger = softer. Converted to a linear scale by exp2(-s), which
// is FSR1's convention.
uniform float uSharpness;

// The strongest lobe RCAS ever applies. 0.25 would be the natural limit of the
// kernel; FSR1 backs off to 0.25 - 1/16 to stay clear of it.
const float kRcasLimit = 0.25 - 1.0 / 16.0;

vec3 fetchClamped(ivec2 p, ivec2 size) {
    return texelFetch(uInput, clamp(p, ivec2(0), size - 1), 0).rgb;
}

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(uOutput);
    if (any(greaterThanEqual(pos, size))) return;

    //    b
    //  d e f
    //    h
    vec3 b = fetchClamped(pos + ivec2(0, -1), size);
    vec3 d = fetchClamped(pos + ivec2(-1, 0), size);
    vec3 e = fetchClamped(pos, size);
    vec3 f = fetchClamped(pos + ivec2(1, 0), size);
    vec3 h = fetchClamped(pos + ivec2(0, 1), size);

    vec3 mn4 = min(min(b, d), min(f, h));
    vec3 mx4 = max(max(b, d), max(f, h));

    // How much headroom there is towards black and towards white. The 4.0 is
    // the total weight of the four ring taps.
    // Both denominators are guarded away from zero: an all-black ring makes
    // the first one vanish, an all-white ring the second.
    vec3 hitMin = min(mn4, e) / max(4.0 * mx4, vec3(1e-5));
    vec3 hitMax = (vec3(1.0) - max(mx4, e)) / min(4.0 * mn4 - 4.0, vec3(-1e-5));
    vec3 lobeRGB = max(-hitMin, hitMax);

    // The channel closest to clipping decides for all three, otherwise
    // sharpening would shift hue at saturated edges.
    float lobe = max(-kRcasLimit, min(max(max(lobeRGB.r, lobeRGB.g), lobeRGB.b), 0.0));
    lobe *= exp2(-uSharpness);

    vec3 result = (lobe * (b + d + f + h) + e) / (4.0 * lobe + 1.0);
    imageStore(uOutput, pos, vec4(clamp(result, 0.0, 1.0), 1.0));
}
