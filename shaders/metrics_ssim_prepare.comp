#version 460 core

// Stage 1 of structural similarity: turn the two images into the per-pixel
// terms SSIM needs (luma, squares, product) so the following passes only have
// to run a separable Gaussian over them.
layout(local_size_x = 8, local_size_y = 8) in;

#include "metrics_common.glsl"

layout(binding = 0) uniform sampler2D uA;
layout(binding = 1) uniform sampler2D uB;
layout(binding = 2) uniform sampler2D uVelocity;

layout(binding = 0, rgba32f) writeonly uniform image2D uStats0;  // a, b, a*a, b*b
layout(binding = 1, rg32f) writeonly uniform image2D uStats1;    // a*b, valid

uniform int uMode;     // 0 direct, 1 reproject B by the velocity buffer
uniform int uTonemap;
uniform vec2 uSize;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= int(uSize.x) || coord.y >= int(uSize.y)) return;

    vec2 uv = (vec2(coord) + 0.5) / uSize;
    vec2 sampleUV = uv;
    float valid = 1.0;

    if (uMode == 1) {
        sampleUV = uv + texture(uVelocity, uv).rg;
        bool onScreen = all(greaterThanEqual(sampleUV, vec2(0.0))) &&
                        all(lessThanEqual(sampleUV, vec2(1.0)));
        valid = onScreen ? 1.0 : 0.0;
    }

    float a = metricsLuma(metricsToDisplay(texture(uA, uv).rgb, uTonemap));
    float b = metricsLuma(metricsToDisplay(texture(uB, sampleUV).rgb, uTonemap));

    // Invalid pixels are zeroed rather than skipped so the Gaussian can be run
    // unconditionally; the blurred validity mask normalises the result.
    imageStore(uStats0, coord, vec4(a, b, a * a, b * b) * valid);
    imageStore(uStats1, coord, vec4(a * b * valid, valid, 0.0, 0.0));
}
