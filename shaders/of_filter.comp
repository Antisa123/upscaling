#version 460 core

// M6, pass 5: 3x3 vector median.
//
// Block matching produces outliers by construction. A block that happens to
// contain only a flat wall, or a repeating texture, has no unique minimum, and
// the one it reports can be anything. Those blocks are isolated -- their
// neighbours, which contain structure, agree with each other -- so a median
// removes them while leaving real motion discontinuities intact. That is the
// property a mean does not have: averaging across a silhouette invents a
// vector that belongs to neither side.
//
// "Median" of a 2D quantity means the vector median: the candidate with the
// smallest total distance to all the others. Taking the median of x and of y
// separately would produce a vector that no block actually voted for.

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D uFlow;
layout(rgba16f, binding = 0) uniform writeonly image2D uOutput;

uniform ivec2 uBlockGrid;
uniform ivec2 uLevelSize;
uniform int uEnabled;

void main() {
    const ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pos, uBlockGrid))) return;

    if (uEnabled == 0) {
        imageStore(uOutput, pos, texelFetch(uFlow, pos, 0));
        return;
    }

    vec4 n[9];
    const ivec2 maxCoord = uBlockGrid - 1;
    for (int y = -1; y <= 1; ++y)
        for (int x = -1; x <= 1; ++x)
            n[(y + 1) * 3 + (x + 1)] =
                texelFetch(uFlow, clamp(pos + ivec2(x, y), ivec2(0), maxCoord), 0);

    // Distances in texels of this level rather than UV, purely so the numbers
    // stay in a range where fp16 storage and fp32 arithmetic are comfortable.
    const vec2 scale = vec2(uLevelSize);
    float bestCost = 1e30;
    int best = 4;
    for (int i = 0; i < 9; ++i) {
        float cost = 0.0;
        for (int j = 0; j < 9; ++j)
            cost += length((n[i].xy - n[j].xy) * scale);
        if (cost < bestCost) {
            bestCost = cost;
            best = i;
        }
    }
    imageStore(uOutput, pos, n[best]);
}
