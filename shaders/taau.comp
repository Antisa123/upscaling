#version 460 core

// M4 - minimalni temporalni upscaler (TAAU).
//
// The three parts the milestone is defined by, and nothing else:
//
//   1. reprojection  - the display-resolution history is resampled at
//                      uv + motion vector, so it follows the scene;
//   2. accumulation  - the current render-resolution frame contributes new
//                      sub-pixel samples (the camera jitters every frame), and
//                      the running average of those samples *is* the extra
//                      resolution; no spatial filter can invent it;
//   3. clamp         - history that no longer fits the local colour range of
//                      the current frame is pulled back into it, which is what
//                      stops disocclusions and shading changes from ghosting.
//
// Deliberately *not* here, because they belong to M5 and each one wants its
// own ablation row in the table: velocity dilation, depth-based disocclusion
// rejection, locks, the luminance pyramid, the reactive mask, and a Lanczos
// reconstruction kernel.
//
// Everything is display-referred [0,1]; the tone map ran before this pass.

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D uInput;     // render res, current frame
layout(binding = 1) uniform sampler2D uHistory;   // display res, rgb + weight in .a
layout(binding = 2) uniform sampler2D uVelocity;  // render res, UV space, current -> previous
layout(rgba16f, binding = 0) uniform writeonly image2D uOutput;

uniform vec2 uInputSize;
uniform vec2 uInvInputSize;
uniform vec2 uOutputSize;
uniform vec2 uInvOutputSize;
// Sub-pixel offset the current frame was rendered with, in render pixels.
uniform vec2 uJitter;
// Accumulation cap, in frames. Higher = closer to a true supersample on static
// content, but also longer-lived ghosting when the clamp fails to catch a
// change. FSR2 lands in the same 8-12 range.
uniform float uMaxWeight;
// 1 on the first frame and after a resize: there is no history to trust.
uniform int uReset;
// Width of the variance box, in standard deviations. Around 1 is where TAA
// implementations land: lower trades detail for stability, higher the reverse.
uniform float uClampGamma;
// Rate at which the accumulation cap decays with image-space motion, per
// display pixel per frame. 0 keeps the cap fixed.
uniform float uMotionDecay;
// Inverse variance of the reconstruction kernel, in render pixels^-2.
uniform float uKernel;

// YCoCg is the colour space the clamp lives in. Clamping the three RGB channels
// independently is the obvious implementation and it shifts hue: on a floor of
// bright stone and dark grout the history's red gets pulled back while its blue
// does not, and the pixel comes out magenta. YCoCg puts one axis on luminance
// and two on chroma, so the same operation moves brightness without dragging
// colour with it. The transform is exact and costs a handful of adds each way.
vec3 rgbToYCoCg(vec3 c) {
    return vec3(0.25 * c.r + 0.5 * c.g + 0.25 * c.b,
                0.5 * c.r - 0.5 * c.b,
                -0.25 * c.r + 0.5 * c.g - 0.25 * c.b);
}

vec3 yCoCgToRgb(vec3 c) {
    return vec3(c.x + c.y - c.z, c.x + c.z, c.x - c.y - c.z);
}

// Pull `history` into the box by walking it along the line towards the box
// centre, rather than snapping each axis on its own. A per-axis snap lands on a
// corner of the box - a colour that may appear nowhere in the neighbourhood -
// while the line clip lands on the face it actually crosses, which is the
// nearest colour the current frame can vouch for.
vec3 clipToBox(vec3 history, vec3 lo, vec3 hi) {
    const vec3 center = 0.5 * (hi + lo);
    const vec3 extent = 0.5 * (hi - lo) + 1e-6;
    const vec3 d = history - center;
    const vec3 unit = abs(d / extent);
    const float maxUnit = max(max(unit.x, unit.y), unit.z);
    return maxUnit > 1.0 ? center + d / maxUnit : history;
}

// Catmull-Rom resample of the history. Bilinear is the obvious choice and the
// wrong one: the history is resampled *every* frame, so a filter that loses a
// little sharpness per frame loses all of it after a dozen, and the image
// converges to mush no matter how good the accumulation is. Catmull-Rom is
// interpolating and mildly sharpening, which cancels that drift.
// Nine bilinear fetches, the standard 3x3 factorisation of the 4x4 kernel.
vec4 sampleHistory(vec2 uv) {
    vec2 samplePos = uv * uOutputSize;
    vec2 texPos1 = floor(samplePos - 0.5) + 0.5;
    vec2 f = samplePos - texPos1;

    vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
    vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
    vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
    vec2 w3 = f * f * (-0.5 + 0.5 * f);

    vec2 w12 = w1 + w2;
    vec2 offset12 = w2 / max(w12, vec2(1e-5));

    vec2 p0 = (texPos1 - 1.0) * uInvOutputSize;
    vec2 p3 = (texPos1 + 2.0) * uInvOutputSize;
    vec2 p12 = (texPos1 + offset12) * uInvOutputSize;

    vec4 r = vec4(0.0);
    r += texture(uHistory, vec2(p0.x,  p0.y))  * (w0.x  * w0.y);
    r += texture(uHistory, vec2(p12.x, p0.y))  * (w12.x * w0.y);
    r += texture(uHistory, vec2(p3.x,  p0.y))  * (w3.x  * w0.y);
    r += texture(uHistory, vec2(p0.x,  p12.y)) * (w0.x  * w12.y);
    r += texture(uHistory, vec2(p12.x, p12.y)) * (w12.x * w12.y);
    r += texture(uHistory, vec2(p3.x,  p12.y)) * (w3.x  * w12.y);
    r += texture(uHistory, vec2(p0.x,  p3.y))  * (w0.x  * w3.y);
    r += texture(uHistory, vec2(p12.x, p3.y))  * (w12.x * w3.y);
    r += texture(uHistory, vec2(p3.x,  p3.y))  * (w3.x  * w3.y);
    return r;
}

void main() {
    const ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 outSize = ivec2(uOutputSize);
    if (any(greaterThanEqual(pos, outSize))) return;

    const vec2 outUV = (vec2(pos) + 0.5) * uInvOutputSize;

    // Where this display pixel sits in the render target.
    //
    // The frame was drawn with the projection shifted by uJitter pixels, so
    // render texel i shows the scene as it would appear at i - uJitter. Adding
    // the jitter back is what turns a per-frame offset into new information
    // instead of noise: this is the one line that separates TAAU from a
    // spatial filter run repeatedly.
    const vec2 srcF = outUV * uInputSize - 0.5;  // unjittered render coordinates
    const vec2 samplePos = srcF + uJitter;       // ... in the jittered frame
    const ivec2 base = ivec2(floor(samplePos + 0.5));
    const ivec2 maxTap = ivec2(uInputSize) - 1;

    // Current frame: reconstruct the display pixel from the 3x3 render taps
    // around it, and collect the neighbourhood the history has to stay inside.
    vec3 cur = vec3(0.0);
    float kernelSum = 0.0;
    float nearest2 = 1e30;
    // Neighbourhood statistics, in YCoCg: hard bounds plus the first two moments
    // the variance clip is built from.
    vec3 nMin = vec3(1e30);
    vec3 nMax = vec3(-1e30);
    vec3 m1 = vec3(0.0);
    vec3 m2 = vec3(0.0);
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            const ivec2 offset = ivec2(x, y);
            const vec3 c = texelFetch(uInput, clamp(base + offset, ivec2(0), maxTap), 0).rgb;
            const vec3 cy = rgbToYCoCg(c);
            nMin = min(nMin, cy);
            nMax = max(nMax, cy);
            m1 += cy;
            m2 += cy * cy;

            const vec2 d = vec2(base + offset) - samplePos;
            const float d2 = dot(d, d);
            nearest2 = min(nearest2, d2);
            // Gaussian reconstruction kernel, sigma = 0.25 render pixels.
            //
            // The width is the single biggest lever on the result and the
            // intuition points the wrong way. A wide kernel gives a clean,
            // stable single frame - and that is all it ever gives, because the
            // only high frequencies the accumulation can average are the ones
            // an individual frame delivered. A narrow kernel produces a noisy
            // frame whose noise is exactly the jitter pattern, which is what
            // averages away into resolution. Measured on Sponza, going from
            // sigma 0.5 to 0.25 is worth half a dB; narrower than this the
            // 3x3 taps stop mattering and it degenerates to nearest.
            const float w = exp(-uKernel * d2);
            cur += c * w;
            kernelSum += w;
        }
    }
    cur /= max(kernelSum, 1e-5);

    // How well this display pixel is covered by the current frame. At a 2x
    // scale most pixels have no sample near them on any given frame; weighting
    // by coverage is what lets the well-sampled frames carry the result
    // instead of every frame contributing equally.
    const float coverage = exp(-uKernel * nearest2);

    // Reprojection. The velocity buffer is fetched, not filtered: bilinear
    // across a silhouette blends a moving object's vector with the
    // background's and lands the history somewhere neither of them was.
    const vec2 mv = texelFetch(uVelocity, clamp(base, ivec2(0), maxTap), 0).rg;
    const vec2 prevUV = outUV + mv;

    // Motion-adaptive accumulation length.
    //
    // Resampling the history is not free: any interpolating filter has a zero
    // at Nyquist when it lands on a half-pixel phase, so a frame of motion that
    // is not a whole number of display pixels strips the finest detail out of
    // the history. Feeding that back at 90% per frame turns a per-frame loss
    // into a steady-state one - the accumulated image converges to roughly
    // 1/N of the detail a single frame has, which is why a long history looks
    // sharp on a still camera and soft the moment it moves.
    //
    // Shortening the history where the image is moving fast spends exactly the
    // frames that were costing detail, and keeps the long history where it pays
    // for itself. uMotionDecay = 0 disables this and restores the fixed cap.
    const float mvPixels = length(mv * uOutputSize);
    const float maxWeight = mix(1.0, uMaxWeight, exp(-uMotionDecay * mvPixels));

    vec4 history = sampleHistory(prevUV);
    float historyWeight = clamp(history.a, 0.0, maxWeight);
    const bool offscreen = any(lessThan(prevUV, vec2(0.0))) || any(greaterThan(prevUV, vec2(1.0)));
    if (uReset != 0 || offscreen) historyWeight = 0.0;

    // Clamp, then blend. Clamping first matters: a history sample that is
    // stale but still inside the current neighbourhood is usable information,
    // and throwing it away would cost exactly the resolution this pass exists
    // to recover.
    //
    // The bounds are the neighbourhood's mean plus or minus uClampGamma standard
    // deviations, intersected with its hard min/max. The min/max box on its own
    // is set by the two most extreme of nine taps, so a single bright speck
    // widens it enough to let a whole frame of stale colour through; the
    // variance box tracks what the neighbourhood actually looks like. It closes
    // on smooth content, where ghosting is most visible, and still opens up
    // across an edge, where rejecting history would cost detail.
    const vec3 mu = m1 * (1.0 / 9.0);
    const vec3 sigma = sqrt(max(m2 * (1.0 / 9.0) - mu * mu, vec3(0.0)));
    const vec3 lo = max(mu - uClampGamma * sigma, nMin);
    const vec3 hi = min(mu + uClampGamma * sigma, nMax);
    const vec3 historyColor = yCoCgToRgb(clipToBox(rgbToYCoCg(history.rgb), lo, hi));

    const float total = historyWeight + coverage;
    const vec3 result = (historyColor * historyWeight + cur * coverage) / max(total, 1e-5);

    imageStore(uOutput, pos, vec4(result, min(total, maxWeight)));
}
